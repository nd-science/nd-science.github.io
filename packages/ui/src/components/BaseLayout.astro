    scienceHeading: "Identifiants de recherche",
    legalHeading: "Informations légales",
    backToTop: "Haut de page",
    sitemap: "Plan du site",
    privacy: "Politique de confidentialité",
    consent: "Consentement au traitement des données",
    offer: "Conditions de service",
    informedConsent: "Consentement éclairé",
    dissertation: "Dépôt de thèse (MACAU)",
