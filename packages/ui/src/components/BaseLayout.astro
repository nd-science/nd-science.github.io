---
import { nataliaProfile, type Locale } from "@natali/profile";
import {
  absoluteUrl,
  buildSeo,
  createBreadcrumbJsonLd,
  createPersonJsonLd,
  type LocalizedPaths,
  type PersonJsonLdDetails,
  type SiteStatus,
} from "@natali/seo";
import "../styles/base.css";
import "../styles/themes.css";

interface NavItem {
  href: string;
  label: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string | undefined;
}

interface CrossSiteLink {
  label: string;
  href: string;
}

interface Props {
  locale: Locale;
  theme: "wellness" | "science";
  siteLabel: string;
  title: string;
  description: string;
  paths: LocalizedPaths;
  fallbackSiteUrl: string;
  navItems: NavItem[];
  currentPath: string;
  crossSite?: CrossSiteLink | undefined;
  breadcrumbs?: BreadcrumbItem[] | undefined;
  personDetails?: PersonJsonLdDetails | undefined;
  jsonLd?: Record<string, unknown>[] | undefined;
  ogImage?: string | undefined;
  footerText: string;
}

const {
  locale,
  theme,
  siteLabel,
  title,
  description,
  paths,
  fallbackSiteUrl,
  navItems,
  currentPath,
  crossSite,
  breadcrumbs,
  personDetails,
  jsonLd,
  ogImage,
  footerText,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || fallbackSiteUrl;
const status: SiteStatus =
  import.meta.env.PUBLIC_SITE_STATUS === "public" ? "public" : "draft";
const seo = buildSeo({ siteUrl, locale, paths, status });
const socialImage = ogImage || absoluteUrl(siteUrl, "/favicon.svg");
const personJsonLd = createPersonJsonLd(
  nataliaProfile,
  locale,
  seo.canonical,
  personDetails,
);

const labels =
  locale === "ru"
    ? {
        skip: "Перейти к содержанию",
        draft: "Черновик: сайт ещё не выпущен, контент и условия уточняются",
        nav: "Основная навигация",
        language: "Язык",
        breadcrumbs: "Хлебные крошки",
        home: "Главная",
        path: "Путь",
        crossSite: "Перейти на второй сайт Наталии Долговой",
        statusBadge: "Черновик (noindex)",
        navHeading: "Навигация",
        contactsHeading: "Связь и профили",
        scienceHeading: "Научные профили",
        legalHeading: "Правовая информация",
        backToTop: "Наверх",
      }
    : {
        skip: "Skip to content",
        draft: "Draft: the site has not launched yet; content and terms are being finalised",
        nav: "Primary navigation",
        language: "Language",
        breadcrumbs: "Breadcrumbs",
        home: "Home",
        path: "Path",
        crossSite: "Go to Nataliia Dolgova’s second website",
        statusBadge: "Draft (noindex)",
        navHeading: "Navigation",
        contactsHeading: "Contacts & Profiles",
        scienceHeading: "Research Identifiers",
        legalHeading: "Legal & Documents",
        backToTop: "Back to top",
      };

const breadcrumbChain = [
  { label: labels.home, href: `/${locale}/` },
  ...(breadcrumbs ?? []),
];

const breadcrumbJsonLd =
  breadcrumbChain.length > 1
    ? createBreadcrumbJsonLd(siteUrl, breadcrumbChain, seo.canonical)
    : undefined;

const allJsonLd = [
  personJsonLd,
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...(jsonLd ?? []),
];

const currentYear = new Date().getUTCFullYear();
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="robots" content={seo.robots} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={locale === "ru" ? "ru_RU" : "en_US"} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "od8PTNpX3EwB1eK7vjlpEAYKrfkwkxFKHj0X-Y4csXc"} />
    <meta name="yandex-verification" content={theme === "wellness" ? "7369f633f79a694f" : "80f02dc8bb2d1a79"} />
    <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION || "bing-verification-pending"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {
      seo.alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }
    <title>{title}</title>
    {
      allJsonLd.map((block) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
    {status === "public" && analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skip}</a>
    <header class="site-header">
      <div class="site-topbar">
        <a class="brand identity" href={`/${locale}/`}>
          <span class="brand-mark identity-mark" aria-hidden="true">ND</span>
          <span class="brand-name">{nataliaProfile.displayName[locale]}</span>
        </a>
        <div class="header-tools">
          <nav class="locale-switcher language-switcher" aria-label={labels.language}>
            <a href={paths.ru} lang="ru" aria-current={locale === "ru" ? "page" : undefined}>RU</a>
            <span class="locale-sep" aria-hidden="true">/</span>
            <a href={paths.en} lang="en" aria-current={locale === "en" ? "page" : undefined}>EN</a>
          </nav>
          {
            crossSite && (
              <a
                class="cross-site-link"
                href={crossSite.href}
                aria-label={labels.crossSite}
              >
                <span>{crossSite.label}</span>
                <span aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>
      <nav class="page-nav" aria-label={labels.nav}>
        <ul class="page-tabs nav-list">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.href === currentPath ? "page" : undefined}
                >
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    {
      breadcrumbChain.length > 1 && (
        <nav class="context-bar breadcrumbs" aria-label={labels.breadcrumbs}>
          <ol class="context-crumbs">
            {breadcrumbChain.map((item, index) => (
              <li>
                {item.href && index < breadcrumbChain.length - 1 ? (
                  <a href={item.href}>{item.label}</a>
                ) : (
                  <span aria-current="page">{item.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-col brand-col">
            <a class="brand identity" href={`/${locale}/`}>
              <span class="brand-mark identity-mark" aria-hidden="true">ND</span>
              <span class="brand-name">{nataliaProfile.displayName[locale]}</span>
            </a>
            <p class="footer-tagline">
              {theme === "wellness"
                ? (locale === "ru"
                  ? "Психологическое консультирование, нейроинтеграция, дыхание и оздоровительное движение."
                  : "Psychological counselling, neurointegration, breathing and movement.")
                : (locale === "ru"
                  ? "Исследования профессионального образования, подготовка педагогов и обучение взрослых."
                  : "Research in vocational education, educator training and adult learning.")}
            </p>
            <div class="footer-status-pill">
              <span class="site-dot" aria-hidden="true"></span>
              <span>{siteLabel}</span>
            </div>
          </div>

          <div class="footer-col nav-col">
            <h2 class="footer-heading">{labels.navHeading}</h2>
            <ul class="footer-nav-list">
              {navItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
              <li><a href={`/${locale}/sitemap/`}>{locale === "ru" ? "Карта сайта" : "Sitemap"}</a></li>
            </ul>
          </div>

          <div class="footer-col resources-col">
            <h2 class="footer-heading">{theme === "wellness" ? labels.contactsHeading : labels.scienceHeading}</h2>
            {theme === "wellness" ? (
              <ul class="footer-contact-list">
                <li><a href="https://t.me/natali_tvet_pro" target="_blank" rel="noopener noreferrer">Telegram: @natali_tvet_pro</a></li>
                <li><a href="https://t.me/natalicompass" target="_blank" rel="noopener noreferrer">{locale === "ru" ? "Канал" : "Channel"}: @natalicompass</a></li>
                <li><a href="https://www.b17.ru/dolgova_nataliya/" target="_blank" rel="noopener noreferrer">{locale === "ru" ? "Анкета B17" : "B17 Profile"} ↗</a></li>
                <li><a href="https://trainer.neurointegration.org/profile/966067701912-nataliya-dolgova" target="_blank" rel="noopener noreferrer">{locale === "ru" ? "Реестр тренеров" : "Trainers Register"} ↗</a></li>
              </ul>
            ) : (
              <ul class="footer-contact-list">
                <li><a href="https://scholar.google.com/citations?user=BtLwD8UAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></li>
                <li><a href="https://orcid.org/0000-0003-0816-2103" target="_blank" rel="noopener noreferrer">ORCID: 0000-0003-0816-2103 ↗</a></li>
                <li><a href="https://www.elibrary.ru/author_profile.asp?id=687073" target="_blank" rel="noopener noreferrer">РИНЦ: 687073 ↗</a></li>
                <li><a href="https://www.scopus.com/authid/detail.uri?authorId=57202091034" target="_blank" rel="noopener noreferrer">Scopus: 57202091034 ↗</a></li>
                <li><a href="https://www.webofscience.com/wos/author/record/A-9484-2016" target="_blank" rel="noopener noreferrer">ResearcherID: A-9484-2016 ↗</a></li>
                <li><a href="https://www.linkedin.com/in/natalidolgova" target="_blank" rel="noopener noreferrer">LinkedIn: natalidolgova ↗</a></li>
                <li><a href="https://t.me/natali_tvet_pro" target="_blank" rel="noopener noreferrer">Telegram: @natali_tvet_pro</a></li>
              </ul>
            )}
          </div>

          <div class="footer-col legal-col">
            <h2 class="footer-heading">{labels.legalHeading}</h2>
            {theme === "wellness" ? (
              <ul class="footer-legal-list">
                <li><a href={`/${locale}/offer/`}>{locale === "ru" ? "Договор-оферта" : "Service Agreement"}</a></li>
                <li><a href={`/${locale}/consent/`}>{locale === "ru" ? "Информированное согласие" : "Informed Consent"}</a></li>
                <li><a href={`/${locale}/privacy/`}>{locale === "ru" ? "Политика обработки ПДн" : "Privacy Policy"}</a></li>
                <li><span class="tax-info">{locale === "ru" ? "Самозанятая Долгова Н. Э., ИНН 575210528203" : "Self-employed N. E. Dolgova, Tax ID 575210528203"}</span></li>
              </ul>
            ) : (
              <ul class="footer-legal-list">
                <li><a href={`/${locale}/privacy/`}>{locale === "ru" ? "Политика обработки ПДн" : "Privacy Policy"}</a></li>
                <li><a href={`/${locale}/consent/`}>{locale === "ru" ? "Согласие на обработку ПДн" : "Data Consent"}</a></li>
                <li><a href="https://macau.uni-kiel.de/receive/macau_mods_00002008" target="_blank" rel="noopener noreferrer">{locale === "ru" ? "Диссертация (MACAU)" : "Dissertation Repository"} ↗</a></li>
                <li><a href="https://www.researchgate.net/profile/Natalia-Dolgova-2" target="_blank" rel="noopener noreferrer">ResearchGate ↗</a></li>
                <li><span class="tax-info">{locale === "ru" ? "Самозанятая Долгова Н. Э., ИНН 575210528203" : "Self-employed N. E. Dolgova, Tax ID 575210528203"}</span></li>
              </ul>
            )}
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {currentYear} {nataliaProfile.displayName[locale]}. {footerText}</p>
          <a class="back-to-top" href="#main-content">↑ {labels.backToTop}</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const centerActiveTab = () => {
          const nav = document.querySelector('.page-nav');
          const activeTab = document.querySelector('.page-tabs a[aria-current="page"]');
          if (nav && activeTab && nav.scrollWidth > nav.clientWidth) {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const targetLeft = activeTab.offsetLeft - (nav.clientWidth / 2) + (activeTab.offsetWidth / 2);
            nav.scrollTo({
              left: Math.max(0, targetLeft),
              behavior: prefersReducedMotion ? 'instant' : 'smooth'
            });
          }
        };
        if (typeof requestAnimationFrame === 'function') {
          requestAnimationFrame(() => requestAnimationFrame(centerActiveTab));
        } else {
          centerActiveTab();
        }
      })();
    </script>
  </body>
</html>
