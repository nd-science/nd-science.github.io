    breadcrumbs: "Fil d'Ariane",
    home: "Accueil",
    path: "Chemin",
    crossSite: "Aller sur le second site de Nataliia Dolgova",
    secondSite: "Second projet de Nataliia :",
    statusBadge: "Brouillon (noindex)",
    navHeading: "Navigation",
