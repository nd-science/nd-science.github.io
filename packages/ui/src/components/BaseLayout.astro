---
import { nataliaProfile, SUPPORTED_LOCALES, type Locale } from "@natali/profile";
import {
  absoluteUrl,
  buildSeo,
  createBreadcrumbJsonLd,
  createPersonJsonLd,
  type LocalizedPaths,
  type PersonJsonLdDetails,
  type SiteStatus,
} from "@natali/seo";
import "../styles/base.css";
import "../styles/themes.css";

interface NavItem {
  href: string;
  label: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string | undefined;
}

interface CrossSiteLink {
  label: string;
  category?: string | undefined;
  href: string;
}

interface Props {
  locale: Locale;
  theme: "wellness" | "science";
  siteLabel: string;
  title: string;
  description: string;
  paths: LocalizedPaths;
  fallbackSiteUrl: string;
  navItems: NavItem[];
  currentPath: string;
  crossSite?: CrossSiteLink | undefined;
  breadcrumbs?: BreadcrumbItem[] | undefined;
  personDetails?: PersonJsonLdDetails | undefined;
  jsonLd?: Record<string, unknown>[] | undefined;
  ogImage?: string | undefined;
  footerText: string;
}

const {
  locale,
  theme,
  siteLabel,
  title,
  description,
  paths,
  fallbackSiteUrl,
  navItems,
  currentPath,
  crossSite,
  breadcrumbs,
  personDetails,
  jsonLd,
  ogImage,
  footerText,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || fallbackSiteUrl;
const defaultCrossSiteOrigin = theme === "science"
  ? (import.meta.env.PUBLIC_WELLNESS_SITE_URL || "https://natalicompass.com").replace(/\/+$/, "")
  : (import.meta.env.PUBLIC_SCIENCE_SITE_URL || "https://tvet.si").replace(/\/+$/, "");

const effectiveCrossSite: CrossSiteLink = crossSite || {
  category: theme === "science"
    ? (locale === "ru" ? "Саморегуляция и здоровье" : "Wellbeing & Practice")
    : (locale === "ru" ? "Наука и образование" : "Research & Academia"),
  label: theme === "science"
    ? (locale === "ru" ? "Наталия о саморегуляции и здоровье" : "Nataliia on wellbeing and self-regulation")
    : (locale === "ru" ? "Наталия о науке и исследованиях" : "Nataliia on research and education"),
  href: `${defaultCrossSiteOrigin}/${locale}/`,
};

const status: SiteStatus =
  import.meta.env.PUBLIC_SITE_STATUS === "public" ? "public" : "draft";
const seo = buildSeo({ siteUrl, locale, paths, status });
const socialImage = ogImage || absoluteUrl(siteUrl, "/images/natalia-portrait.png");
const personJsonLd = createPersonJsonLd(
  nataliaProfile,
  locale,
  seo.canonical,
  {
    image: absoluteUrl(siteUrl, "/images/natalia-portrait.png"),
    ...personDetails,
  },
);

const allLabels: Record<Locale, Record<string, string>> = {
  ru: {
    skip: "Перейти к содержанию",
