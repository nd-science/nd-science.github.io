  },
  es: {
    skip: "Ir al contenido principal",
    draft: "Borrador: el sitio aún no se ha publicado; el contenido y los términos se están finalizando",
    nav: "Navegación principal",
    language: "Idioma",
    breadcrumbs: "Miga de pan",
    home: "Inicio",
    path: "Ruta",
    crossSite: "Ir al segundo sitio web de Nataliia Dolgova",
    secondSite: "Segundo proyecto de Nataliia:",
    statusBadge: "Borrador (noindex)",
    navHeading: "Navegación",
    contactsHeading: "Contactos y perfiles",
    scienceHeading: "Identificadores de investigación",
    legalHeading: "Información legal",
    backToTop: "Volver arriba",
    sitemap: "Mapa del sitio",
    privacy: "Política de privacidad",
    consent: "Consentimiento de tratamiento de datos",
    offer: "Contrato de servicios",
    informedConsent: "Consentimiento informado",
    dissertation: "Repositorio de tesis (MACAU)",
    taxInfo: "Autónoma N. E. Dolgova, NIF 575210528203",
    channel: "Canal",
    b17: "Perfil B17",
    trainersRegister: "Registro de entrenadores",
    elibrary: "eLibrary (RSCI): 687073",
  },
