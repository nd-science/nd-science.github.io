const labels = allLabels[locale] || allLabels.en;

const footerTaglines: Record<string, Record<Locale, string>> = {
  wellness: {
    ru: "Психологическое консультирование, нейроинтеграция, дыхание и оздоровительное движение.",
    en: "Psychological counselling, neurointegration, breathing and movement.",
    zh: "心理咨询、神经整合、呼吸实践与身心调养。",
    de: "Psychologische Beratung, Neurointegration, Atem- und Bewegungspraxis.",
    fr: "Conseil psychologique, neuro-intégration, respiration et mouvement.",
    es: "Asesoramiento psicológico, neurointegración, respiración y movimiento.",
  },
  science: {
    ru: "Исследования профессионального образования, подготовка педагогов и обучение взрослых.",
    en: "Research in vocational education, educator training and adult learning.",
    zh: "职业教育研究、工程教育师资培训与成人学习。",
    de: "Forschung in der Berufsbildung, Lehrkräftebildung und Erwachsenenbildung.",
    fr: "Recherche en formation professionnelle, formation des enseignants et apprentissage des adultes.",
    es: "Investigación en educación vocacional, formación de docentes y aprendizaje de adultos.",
  },
};

const breadcrumbChain = [
  { label: labels.home, href: `/${locale}/` },
  ...(breadcrumbs ?? []),
];

const breadcrumbJsonLd =
  breadcrumbChain.length > 1
    ? createBreadcrumbJsonLd(siteUrl, breadcrumbChain, seo.canonical)
    : undefined;

const allJsonLd = [
  personJsonLd,
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...(jsonLd ?? []),
];

const currentYear = new Date().getUTCFullYear();
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={SUPPORTED_LOCALES[locale]?.htmlLang || locale} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="robots" content={seo.robots} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={SUPPORTED_LOCALES[locale]?.ogLocale || "en_US"} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={nataliaProfile.displayName[locale] || "Nataliia Dolgova"} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="945" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={nataliaProfile.displayName[locale] || "Nataliia Dolgova"} />
    <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "od8PTNpX3EwB1eK7vjlpEAYKrfkwkxFKHj0X-Y4csXc"} />
    {theme === "wellness" ? (
      <>
        <meta name="yandex-verification" content="8c967dade8fdde99" />
        <meta name="yandex-verification" content="7369f633f79a694f" />
      </>
    ) : (
      <>
        <meta name="yandex-verification" content="93943e4841db1496" />
        <meta name="yandex-verification" content="80f02dc8bb2d1a79" />
      </>
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {
      seo.alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }
    <title>{title}</title>
    {
      allJsonLd.map((block) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
    {status === "public" && analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skip}</a>
    <header class="site-header">
      <div class="site-topbar">
        <a class="brand identity" href={`/${locale}/`}>
          <span class="brand-mark identity-mark" aria-hidden="true">ND</span>
          <span class="brand-name">{nataliaProfile.displayName[locale] || nataliaProfile.displayName.en}</span>
        </a>
        <div class="header-tools">
          <nav class="locale-switcher language-switcher" aria-label={labels.language}>
            {
              Object.keys(paths).map((key, idx) => {
                const locKey = key as Locale;
                const locCfg = SUPPORTED_LOCALES[locKey];
                const href = paths[locKey];
                if (!locCfg || !href) return null;
                return (
                  <>
                    {idx > 0 && <span class="locale-sep" aria-hidden="true">/</span>}
                    <a
                      href={href}
                      lang={locCfg.htmlLang}
                      aria-current={locale === locKey ? "page" : undefined}
                    >
                      {locCfg.label}
                    </a>
                  </>
                );
              })
            }
          </nav>
        </div>
      </div>
      <nav class="page-nav" aria-label={labels.nav}>
        <ul class="page-tabs nav-list">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.href === currentPath ? "page" : undefined}
                >
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    {
      breadcrumbChain.length > 1 && (
        <nav class="context-bar breadcrumbs" aria-label={labels.breadcrumbs}>
          <ol class="context-crumbs">
            {breadcrumbChain.map((item, index) => (
              <li>
                {item.href && index < breadcrumbChain.length - 1 ? (
                  <a href={item.href}>{item.label}</a>
                ) : (
                  <span aria-current="page">{item.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-col brand-col">
            <a class="brand identity" href={`/${locale}/`}>
              <span class="brand-mark identity-mark" aria-hidden="true">ND</span>
              <span class="brand-name">{nataliaProfile.displayName[locale] || nataliaProfile.displayName.en}</span>
            </a>
            <p class="footer-tagline">
              {footerTaglines[theme]?.[locale] || footerTaglines[theme]?.en}
            </p>
            <div class="footer-status-pill">
              <span class="site-dot" aria-hidden="true"></span>
              <span>{siteLabel}</span>
            </div>
            {
              effectiveCrossSite && (
                <div class="footer-cross-site">
                  {effectiveCrossSite.category && (
                    <span class="footer-cross-site-label">{effectiveCrossSite.category}</span>
                  )}
                  <a
                    class="footer-cross-site-link"
                    href={effectiveCrossSite.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>{effectiveCrossSite.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              )
            }
          </div>

          <div class="footer-col nav-col">
            <h2 class="footer-heading">{labels.navHeading}</h2>
            <ul class="footer-nav-list">
              {navItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
              <li><a href={`/${locale}/sitemap/`}>{labels.sitemap}</a></li>
              {
                effectiveCrossSite && (
                  <li class="footer-nav-cross-site">
                    <a href={effectiveCrossSite.href} target="_blank" rel="noopener noreferrer">
                      <span>{effectiveCrossSite.label}</span> ↗
                    </a>
                  </li>
                )
              }
            </ul>
          </div>

          <div class="footer-col resources-col">
            <h2 class="footer-heading">{theme === "wellness" ? labels.contactsHeading : labels.scienceHeading}</h2>
            {theme === "wellness" ? (
              <ul class="footer-contact-list">
                <li><a href="mailto:hello@natalicompass.com">Email: hello@natalicompass.com</a></li>
                <li><a href="https://t.me/natali_tvet_pro" target="_blank" rel="noopener noreferrer">Telegram: @natali_tvet_pro</a></li>
                <li><a href="https://t.me/natalicompass" target="_blank" rel="noopener noreferrer">{labels.channel}: @natalicompass</a></li>
                <li><a href="https://www.b17.ru/dolgova_nataliya/" target="_blank" rel="noopener noreferrer">{labels.b17} ↗</a></li>
                <li><a href="https://trainer.neurointegration.org/profile/966067701912-nataliya-dolgova" target="_blank" rel="noopener noreferrer">{labels.trainersRegister} ↗</a></li>
              </ul>
            ) : (
              <ul class="footer-contact-list">
                <li><a href="https://scholar.google.com/citations?user=BtLwD8UAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></li>
                <li><a href="https://orcid.org/0000-0003-0816-2103" target="_blank" rel="noopener noreferrer">ORCID: 0000-0003-0816-2103 ↗</a></li>
                <li><a href="https://www.elibrary.ru/author_profile.asp?id=687073" target="_blank" rel="noopener noreferrer">{labels.elibrary} ↗</a></li>
                <li><a href="https://www.scopus.com/authid/detail.uri?authorId=57202091034" target="_blank" rel="noopener noreferrer">Scopus: 57202091034 ↗</a></li>
                <li><a href="https://www.webofscience.com/wos/author/record/A-9484-2016" target="_blank" rel="noopener noreferrer">ResearcherID: A-9484-2016 ↗</a></li>
                <li><a href="https://www.linkedin.com/in/natalidolgova" target="_blank" rel="noopener noreferrer">LinkedIn: natalidolgova ↗</a></li>
                <li><a href="mailto:contact@tvet.si">Email: contact@tvet.si</a></li>
                <li><a href="https://t.me/natali_tvet_pro" target="_blank" rel="noopener noreferrer">Telegram: @natali_tvet_pro</a></li>
              </ul>
            )}
          </div>

          <div class="footer-col legal-col">
            <h2 class="footer-heading">{labels.legalHeading}</h2>
            {theme === "wellness" ? (
              <ul class="footer-legal-list">
                <li><a href={`/${locale}/offer/`}>{labels.offer}</a></li>
                <li><a href={`/${locale}/consent/`}>{labels.informedConsent}</a></li>
                <li><a href={`/${locale}/privacy/`}>{labels.privacy}</a></li>
                <li><span class="tax-info">{labels.taxInfo}</span></li>
              </ul>
            ) : (
              <ul class="footer-legal-list">
                <li><a href={`/${locale}/privacy/`}>{labels.privacy}</a></li>
                <li><a href={`/${locale}/consent/`}>{labels.consent}</a></li>
                <li><a href="https://macau.uni-kiel.de/receive/macau_mods_00002008" target="_blank" rel="noopener noreferrer">{labels.dissertation} ↗</a></li>
                <li><a href="https://www.researchgate.net/profile/Natalia-Dolgova-2" target="_blank" rel="noopener noreferrer">ResearchGate ↗</a></li>
                <li><span class="tax-info">{labels.taxInfo}</span></li>
              </ul>
            )}
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {currentYear} {nataliaProfile.displayName[locale] || nataliaProfile.displayName.en}. {footerText}</p>
          <a class="back-to-top" href="#main-content">↑ {labels.backToTop}</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const centerActiveTab = () => {
          const nav = document.querySelector('.page-nav');
          const activeTab = document.querySelector('.page-tabs a[aria-current="page"]');
          if (nav && activeTab && nav.scrollWidth > nav.clientWidth) {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const targetLeft = activeTab.offsetLeft - (nav.clientWidth / 2) + (activeTab.offsetWidth / 2);
            nav.scrollTo({
              left: Math.max(0, targetLeft),
              behavior: prefersReducedMotion ? 'instant' : 'smooth'
            });
          }
        };
        if (typeof requestAnimationFrame === 'function') {
          requestAnimationFrame(() => requestAnimationFrame(centerActiveTab));
        } else {
          centerActiveTab();
        }
        try {
          const links = document.querySelectorAll('a[href^="http://"], a[href^="https://"]');
          for (let i = 0; i < links.length; i++) {
            const a = links[i];
            const href = a.getAttribute('href') || '';
            if (!href.includes(window.location.hostname) && !href.includes('.invalid')) {
              if (!a.getAttribute('target')) a.setAttribute('target', '_blank');
              const rel = a.getAttribute('rel') || '';
              if (!rel.includes('noopener')) {
                a.setAttribute('rel', (rel ? rel + ' ' : '') + 'noopener noreferrer');
              }
            }
          }
        } catch (_) {}
      })();
    </script>
  </body>
</html>
