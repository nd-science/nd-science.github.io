---
import BaseLayout from "@natali/ui/BaseLayout.astro";
import { wellnessSiteConfig } from "../site-config";
import { wellnessCopy } from "../i18n";

const locale = "ru";
const copy = wellnessCopy[locale];
const paths = { ru: "/ru/", en: "/en/" };
const currentPath = "/404/";
---

<BaseLayout
  locale={locale}
  theme="wellness"
  siteLabel={copy.siteLabel}
  title={`404: Страница не найдена · ${wellnessSiteConfig.name}`}
  description="Запрашиваемая страница не найдена. Перейдите на главную страницу или воспользуйтесь картой сайта."
  paths={paths}
  fallbackSiteUrl={copy.fallbackSiteUrl}
  navItems={copy.nav}
  currentPath={currentPath}
  footerText={copy.footer}
>
  <section class="page-section error-section">
    <div class="section-inner error-layout">
      <div class="error-badge" aria-hidden="true">404</div>
      <h1>Страница не найдена</h1>
      <p class="error-lead">
        Возможно, адрес набран с ошибкой, страница была перемещена или ещё не создана.
      </p>
      <div class="error-actions">
        <a class="button button--primary" href="/ru/">На главную</a>
        <a class="button secondary" href="/ru/for-individuals/">Форматы и цены</a>
        <a class="button secondary" href="/ru/booking/">Запись и контакты</a>
        <a class="button secondary" href="/ru/sitemap/">Карта сайта</a>
      </div>
      <div class="error-bilingual-note">
        <p>Looking for English content?</p>
        <div class="error-en-links">
          <a href="/en/">Home →</a>
          <a href="/en/for-individuals/">Formats & Pricing →</a>
          <a href="/en/booking/">Booking & Contacts →</a>
          <a href="/en/sitemap/">Site Map →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
