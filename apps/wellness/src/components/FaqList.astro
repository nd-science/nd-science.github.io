---
import type { Locale } from "@natali/profile";
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"faq">[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const loc = (locale === "en" ? "en" : "ru") as "ru" | "en";
---

<div class="faq-list">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.data.question[loc]}</summary>
        <p>{item.data.answer[loc]}</p>
      </details>
    ))
  }
</div>
