---
import type { Locale } from "@natali/profile";
import type { CollectionEntry } from "astro:content";
import { formatMoney } from "@natali/seo";
import { wellnessCopy } from "../i18n";

interface Props {
  variant: "private" | "organisation";
  locale: Locale;
  endpoint?: string | undefined;
  services?: CollectionEntry<"services">[];
  turnstileSiteKey?: string | undefined;
}

const { variant, locale, endpoint, services = [], turnstileSiteKey } = Astro.props;
const copy = wellnessCopy[locale];
const privateForm = copy.forms.private;
const organisationForm = copy.forms.organisation;
const serviceOptions = [...services]
  .sort((a, b) => a.data.name[locale].localeCompare(b.data.name[locale], locale))
  .map((service) => {
    const price = service.data.price
      ? Array.isArray(service.data.price) ? service.data.price[0] : service.data.price
      : undefined;
    const suffix = price ? ` — ${formatMoney(price.amount, locale)}` : "";
    return { id: service.id, label: `${service.data.name[locale]}${suffix}` };
  });
---

{!endpoint ? (
  <div class="direct-contact-card">
    <div class="direct-contact-header">
      <h3>{variant === "private" ? copy.forms.notConnected.privateTitle : copy.forms.notConnected.orgTitle}</h3>
      <p class="direct-contact-intro">{variant === "private" ? copy.forms.notConnected.privateIntro : copy.forms.notConnected.orgIntro}</p>
    </div>

    <div class="direct-contact-action">
      <a class="button button--primary direct-contact-btn" href={copy.forms.notConnected.telegramUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">✈️</span>
        <span>{copy.forms.notConnected.telegramBtn}</span>
        <span aria-hidden="true">↗</span>
      </a>
      {variant === "private" && (
        <div class="direct-contact-secondary">
          <span>{locale === "ru" ? "Или через профили:" : "Or via profiles:"}</span>
          <a href={copy.forms.notConnected.b17Url} target="_blank" rel="noopener noreferrer">{copy.forms.notConnected.b17Label} ↗</a>
          <span aria-hidden="true">·</span>
          <a href={copy.forms.notConnected.vkUrl} target="_blank" rel="noopener noreferrer">{copy.forms.notConnected.vkLabel} ↗</a>
        </div>
      )}
    </div>

    <div class="direct-contact-checklist">
      <p class="checklist-title"><strong>{variant === "private" ? copy.forms.notConnected.checklistTitle : copy.forms.notConnected.orgChecklistTitle}</strong></p>
      <ul>
        {(variant === "private" ? copy.forms.notConnected.checklistItems : copy.forms.notConnected.orgChecklistItems).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="direct-contact-response"><small>⏱ {copy.forms.notConnected.responseTime}</small></p>
    </div>
  </div>
) : (
  <form class="enquiry-form" method="post" action={endpoint} data-enquiry-form>
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="enquiryKind" value={variant} />
    <div class="form-honeypot" aria-hidden="true">
      <label for={`website-${variant}`}>{variant === "private" ? privateForm.honeypot : organisationForm.honeypot}</label>
      <input type="text" id={`website-${variant}`} name="website" tabindex={-1} autocomplete="off" />
    </div>

    {variant === "private" ? (
      <>
        <div class="field">
          <label for="wellness-name">{privateForm.name}</label>
          <input id="wellness-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="wellness-contact">{privateForm.contact}</label>
          <input id="wellness-contact" name="contact" required placeholder={privateForm.contactPlaceholder} />
          <span class="field-hint">{privateForm.contactHint}</span>
        </div>
        <div class="field">
          <label for="wellness-language">{privateForm.language}</label>
          <select id="wellness-language" name="language" required>{copy.forms.languageOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select>
        </div>
        <div class="field"><label for="wellness-timezone">{privateForm.timezone}</label><input id="wellness-timezone" name="timezone" required /></div>
        <div class="field">
          <label for="wellness-delivery">{privateForm.format}</label>
          <select id="wellness-delivery" name="delivery" required>{copy.forms.formatOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select>
        </div>
        <div class="field">
          <label for="wellness-service">{privateForm.service}</label>
          <select id="wellness-service" name="service" required><option value="">{privateForm.servicePlaceholder}</option>{serviceOptions.map((option) => <option value={option.id}>{option.label}</option>)}</select>
        </div>
        <div class="field"><label for="wellness-request">{privateForm.request}</label><textarea id="wellness-request" name="request" maxlength="2000" required></textarea><span class="field-hint">{privateForm.requestHint}</span></div>
        <div class="checkbox-field"><input id="wellness-adult" name="adultConfirmed" type="checkbox" value="yes" required /><label for="wellness-adult">{privateForm.adult}</label></div>
      </>
    ) : (
      <>
        <div class="field"><label for="org-name">{organisationForm.organisation}</label><input id="org-name" name="organisation" autocomplete="organization" required /></div>
        <div class="field"><label for="org-role">{organisationForm.role}</label><input id="org-role" name="role" autocomplete="organization-title" required /></div>
        <div class="field">
          <label for="org-contact">{organisationForm.contact}</label>
          <input id="org-contact" name="contact" required placeholder={organisationForm.contactPlaceholder} />
          <span class="field-hint">{organisationForm.contactHint}</span>
        </div>
        <div class="field">
          <label for="org-language">{organisationForm.language}</label>
          <select id="org-language" name="language" required>{copy.forms.languageOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select>
        </div>
        <div class="field"><label for="org-task">{organisationForm.task}</label><textarea id="org-task" name="request" maxlength="2000" required></textarea></div>
        <div class="field"><label for="org-audience">{organisationForm.groupSize}</label><input id="org-audience" name="audience" required /></div>
        <div class="field">
          <label for="org-delivery">{organisationForm.format}</label>
          <select id="org-delivery" name="delivery" required>{copy.forms.formatOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select>
        </div>
        <div class="field"><label for="org-timeline">{organisationForm.timeline}</label><input id="org-timeline" name="timeline" required /></div>
        <div class="field"><label for="org-comment">{organisationForm.comment}</label><textarea id="org-comment" name="comment" maxlength="2000"></textarea></div>
      </>
    )}

    <div class="checkbox-field"><input id={`consent-${variant}`} name="consent" type="checkbox" value="yes" required /><label for={`consent-${variant}`}>{variant === "private" ? privateForm.consent : organisationForm.consent}</label></div>
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
    <div><button type="submit" class="button">{variant === "private" ? privateForm.submit : organisationForm.submit}</button></div>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>

    <div class="direct-contact-hint">
      <span>{locale === "ru" ? "Или напишите напрямую в мессенджер:" : "Or message directly:"}</span>
      <a class="direct-contact-link" href={copy.forms.notConnected.telegramUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">✈️</span>
        <span>{copy.forms.notConnected.telegramBtn}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </form>
)}

{endpoint && turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const defaultButtonText = button ? button.textContent : "";
      if (button) {
        button.disabled = true;
        button.textContent = document.documentElement.lang === "ru" ? "Отправляем…" : "Sending…";
      }
      if (status) {
        status.className = "form-status form-status--loading";
        status.textContent = document.documentElement.lang === "ru" ? "Отправляем заявку…" : "Sending enquiry…";
      }

      const formData = new FormData(form);
      const payload: Record<string, string> = {};
      formData.forEach((value, key) => {
        if (typeof value === "string") payload[key] = value;
      });

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload),
        });
        const result = (await response.json()) as { ok?: boolean; message?: string };
        if (response.ok && result.ok) {
          form.reset();
          if (status) {
            status.className = "form-status form-status--success";
            status.textContent = result.message || (document.documentElement.lang === "ru"
              ? "✓ Заявка успешно принята! Наталия свяжется с вами в ближайшее время."
              : "✓ Enquiry received! Natalia will get back to you shortly.");
          }
        } else {
          throw new Error(result.message || "Submission failed");
        }
      } catch {
        if (status) {
          status.className = "form-status form-status--error";
          status.textContent =
            document.documentElement.lang === "ru"
              ? "Не удалось отправить заявку через форму. Пожалуйста, напишите Наталии напрямую в Telegram: @natali_tvet_pro"
              : "The enquiry could not be sent. Please message Natalia directly on Telegram: @natali_tvet_pro";
        }
      } finally {
        if (button) {
          button.disabled = false;
          if (defaultButtonText) button.textContent = defaultButtonText;
        }
      }
    });
  });
</script>

<style>
  .direct-contact-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card, 12px);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.25rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }
  .direct-contact-header h3 {
    margin: 0 0 0.5rem;
    color: var(--heading);
    font-size: 1.35rem;
  }
  .direct-contact-intro {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.5;
  }
  .direct-contact-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .direct-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.75rem 1.4rem;
  }
  .direct-contact-secondary {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted-text);
  }
  .direct-contact-secondary a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .direct-contact-checklist {
    background: color-mix(in oklch, var(--background) 50%, var(--surface));
    border-inline-start: 3px solid var(--accent-strong);
    padding: 0.9rem 1.25rem;
    border-radius: 4px;
    font-size: 0.92rem;
  }
  .direct-contact-checklist ul {
    margin: 0.4rem 0 0.6rem;
    padding-inline-start: 1.25rem;
  }
  .direct-contact-checklist li {
    margin-bottom: 0.25rem;
    color: var(--text);
  }
  .direct-contact-response {
    margin: 0;
    color: var(--muted-text);
  }
  .direct-contact-hint {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--muted-text);
  }
  .direct-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .form-status {
    margin-top: 0.75rem;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .form-status--success {
    color: #1b7340;
    background: #eaf6ee;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid #c2e7cc;
  }
  .form-status--error {
    color: #a51d24;
    background: #fdf2f2;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid #f8c8c8;
  }
  .form-status--loading {
    color: var(--muted-text);
    font-style: italic;
  }
</style>
