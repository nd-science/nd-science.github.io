---
import type { Credential, Locale, LifecycleStatus } from "@natali/profile";
import { wellnessCopy } from "../i18n";

interface Props {
  items: Credential[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const copy = wellnessCopy[locale];

function period(credential: Credential): string {
  if (credential.startDate && credential.endDate) {
    return `${credential.startDate}–${credential.endDate}`;
  }
  if (credential.startDate) {
    return credential.startDate;
  }
  return String(credential.year);
}

function lifecycleLabel(status: LifecycleStatus): string | null {
  return status === "completed" ? null : copy.lifecycle[status];
}
---

<ul class="doc-grid" role="list">
  {
    items.map((credential) => (
      <li class="doc-card">
        <div class="doc-preview">
          <div class="doc-seal" aria-hidden="true">★</div>
          {credential.hours && (
            <span class="doc-hours-badge">
              {credential.hours} {locale === "ru" ? "часов" : "hours"}
            </span>
          )}
          <span class="doc-period">
            {credential.year}
          </span>
        </div>
        <div class="doc-body">
          <h3 class="doc-title">{credential.title[locale]}</h3>
          <p class="doc-issuer">{credential.issuer[locale]}</p>
          <div class="doc-footer">
            <span class="doc-period">{period(credential)}</span>
            {lifecycleLabel(credential.lifecycleStatus) ? (
              <span class="badge">{lifecycleLabel(credential.lifecycleStatus)}</span>
            ) : (
              <span class="doc-verified">✓ {locale === "ru" ? "Верифицировано" : "Verified"}</span>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ul>
