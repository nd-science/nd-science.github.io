---
import type { Locale } from "@natali/profile";
import { formatMoney } from "@natali/seo";
import type { CollectionEntry } from "astro:content";
import { wellnessCopy } from "../i18n";

interface Props {
  service: CollectionEntry<"services">;
  locale: Locale;
}

const { service, locale } = Astro.props;
const copy = wellnessCopy[locale];
const data = service.data;

const prices = data.price
  ? Array.isArray(data.price)
    ? data.price
    : [data.price]
  : [];

const priceText =
  prices.length > 0
    ? prices
        .map((price) => {
          let text = formatMoney(price.amount, locale);
          if (price.unit === "participant") {
            text += ` ${copy.units.participant}`;
          }
          if (price.delivery === "online") {
            text += ` ${copy.delivery.online}`;
          }
          if (price.delivery === "in_person") {
            text += ` ${copy.delivery.in_person}`;
          }
          return text;
        })
        .join(" / ")
    : null;

const deliveryLabel = data.delivery
  .map((mode) => copy.delivery[mode])
  .join(", ");

const baseHref = data.cta.href.startsWith("/")
  ? `/${locale}${data.cta.href}`
  : data.cta.href;

const serviceParam = `service=${encodeURIComponent(data.name[locale])}`;
const ctaHref = baseHref.includes("#")
  ? baseHref.replace("#", `?${serviceParam}#`)
  : `${baseHref}${baseHref.includes("?") ? "&" : "?"}${serviceParam}`;

const isRecommended = service.id === "consultation";
const isFlagship = service.id === "four-week-support";
const isB2B = service.id === "b2b-workshop";

const badgeText = isRecommended
  ? locale === "ru" ? "Рекомендуемый старт" : "Recommended Start"
  : isFlagship
    ? locale === "ru" ? "Флагманская программа" : "Flagship Program"
    : isB2B
      ? locale === "ru" ? "Для команд и бизнеса" : "Teams & Leadership"
      : data.serviceAvailability === "pilot"
        ? copy.availability.pilot
        : data.serviceAvailability === "planned"
          ? copy.availability.planned
          : null;
---

<article class={`service-card ${isRecommended ? "service-card--featured" : ""}`}>
  <div class="service-card-header">
    {badgeText && <span class={`badge ${isRecommended ? "badge--featured" : ""}`}>{badgeText}</span>}
    <h3 class="service-card-title">{data.name[locale]}</h3>
  </div>

  <div class="service-price-block">
    <span class="price-value">{priceText ?? data.priceLabel?.[locale]}</span>
  </div>

  <p class="service-task">{data.task[locale]}</p>

  <ul class="service-features" role="list">
    <li>
      <span class="feature-label">{copy.serviceFields.format}:</span>
      <span class="feature-value">{deliveryLabel}{data.duration ? `, ${data.duration[locale]}` : ""}</span>
    </li>
    <li>
      <span class="feature-label">{copy.serviceFields.audience}:</span>
      <span class="feature-value">{data.audience[locale]}</span>
    </li>
    <li>
      <span class="feature-label">{copy.serviceFields.outcome}:</span>
      <span class="feature-value">{data.outcome[locale]}</span>
    </li>
  </ul>

  <div class="service-card-footer">
    <a class={`button ${isRecommended ? "button--primary" : "button--secondary"}`} href={ctaHref}>
      {data.cta.label[locale]}
    </a>
  </div>
</article>
