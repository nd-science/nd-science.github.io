---
import type { Locale } from "@natali/profile";
import type { CollectionEntry } from "astro:content";

interface Props {
  method: CollectionEntry<"methods">;
  locale: Locale;
}

const { method, locale } = Astro.props;
const loc = (locale === "en" ? "en" : "ru") as "ru" | "en";
const href = `/${locale}/practices/${method.id}/`;
---

<article class="card">
  <h3>{method.data.name[loc]}</h3>
  <p>{method.data.summary[loc]}</p>
  <p><a href={href}>{method.data.name[loc]} →</a></p>
</article>
