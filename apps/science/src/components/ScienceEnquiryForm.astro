---
import type { Locale } from "@natali/profile";
import { scienceCopy } from "../i18n";
interface Props { locale: Locale; endpoint?: string | undefined; turnstileSiteKey?: string | undefined }
const { locale, endpoint, turnstileSiteKey } = Astro.props;
const form = scienceCopy[locale].form;
---
{!endpoint || !turnstileSiteKey ? (
  <div class="direct-contact-card">
    <div class="direct-contact-header">
      <h3>{form.notConnected.title}</h3>
      <p class="direct-contact-intro">{form.notConnected.intro}</p>
    </div>

    <div class="direct-contact-action">
      <a class="button button--primary direct-contact-btn" href={form.notConnected.telegramUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">✈️</span>
        <span>{form.notConnected.telegramBtn}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <div class="direct-contact-secondary">
        <a href={form.notConnected.linkedinUrl} target="_blank" rel="noopener noreferrer">{form.notConnected.linkedinLabel} ↗</a>
      </div>
    </div>

    <div class="direct-contact-checklist">
      <p class="checklist-title"><strong>{form.notConnected.checklistTitle}</strong></p>
      <ul>
        {form.notConnected.checklistItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="direct-contact-response"><small>⏱ {form.notConnected.responseTime}</small></p>
    </div>
  </div>
) : (
  <form class="enquiry-form" method="post" action={endpoint} data-enquiry-form>
    <input type="hidden" name="locale" value={locale} />
    <div class="form-honeypot" aria-hidden="true"><label for="science-website">{form.honeypot}</label><input id="science-website" name="website" tabindex={-1} autocomplete="off" /></div>
    <div class="field"><label for="science-name">{form.name}</label><input id="science-name" name="name" autocomplete="name" required /></div>
    <div class="field"><label for="science-organisation">{form.organisation}</label><input id="science-organisation" name="organisation" autocomplete="organization" required /></div>
    <div class="field"><label for="science-role">{form.role}</label><input id="science-role" name="role" autocomplete="organization-title" required /></div>
    <div class="field"><label for="science-email">{form.email}</label><input id="science-email" name="email" type="email" autocomplete="email" required /></div>
    <div class="field">
      <label for="science-language">{form.language}</label>
      <select id="science-language" name="language" required>{scienceCopy[locale].languageOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select>
    </div>
    <div class="field"><label for="science-type">{form.projectType}</label><select id="science-type" name="projectType" required>{scienceCopy[locale].projectTypeOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select></div>
    <div class="field"><label for="science-result">{form.result}</label><textarea id="science-result" name="intendedResult" maxlength="2000" required></textarea></div>
    <div class="field"><label for="science-audience">{form.audience}</label><input id="science-audience" name="audience" required /></div>
    <div class="field"><label for="science-timeline">{form.timeline}</label><input id="science-timeline" name="timeline" required /></div>
    <div class="field"><label for="science-budget">{form.budget}</label><select id="science-budget" name="budgetRange" required>{scienceCopy[locale].budgetOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select></div>
    <div class="field"><label for="science-comment">{form.comment}</label><textarea id="science-comment" name="comment" maxlength="2000"></textarea></div>
    <div class="checkbox-field">
      <input id="science-consent" name="consent" type="checkbox" value="yes" required />
      <label for="science-consent">
        {locale === "ru" ? (
          <>
            Я принимаю условия <a href="/ru/privacy/" target="_blank">Политики конфиденциальности</a> и даю <a href="/ru/consent/" target="_blank">Согласие на обработку персональных данных</a> для ответа на запрос.
          </>
        ) : (
          <>
            I accept the <a href="/en/privacy/" target="_blank">Privacy Policy</a> and provide <a href="/en/consent/" target="_blank">Consent to personal data processing</a> to receive a response.
          </>
        )}
      </label>
    </div>
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
    <button class="button" type="submit">{form.submit}</button>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  </form>
)}
{endpoint && turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => form.addEventListener("submit", async (event) => {
    event.preventDefault(); const status = form.querySelector<HTMLElement>("[data-form-status]"); const button = form.querySelector<HTMLButtonElement>("button");
    if (button) button.disabled = true; if (status) status.textContent = document.documentElement.lang === "ru" ? "Отправляем…" : "Sending…";
    try { const response = await fetch(form.action, { method: "POST", body: new FormData(form) }); const result = await response.json() as { message?: string }; if (status) status.textContent = result.message ?? ""; if (response.ok) form.reset(); }
    catch { if (status) status.textContent = document.documentElement.lang === "ru" ? "Не удалось отправить запрос. Попробуйте позже." : "The enquiry could not be sent. Please try again later."; }
    finally { if (button) button.disabled = false; }
  }));
</script>

<style>
  .direct-contact-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card, 12px);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.25rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }
  .direct-contact-header h3 {
    margin: 0 0 0.5rem;
    color: var(--heading);
    font-size: 1.35rem;
  }
  .direct-contact-intro {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.5;
  }
  .direct-contact-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .direct-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.75rem 1.4rem;
  }
  .direct-contact-secondary {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted-text);
  }
  .direct-contact-secondary a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .direct-contact-checklist {
    background: color-mix(in oklch, var(--background) 50%, var(--surface));
    border-inline-start: 3px solid var(--accent-strong);
    padding: 0.9rem 1.25rem;
    border-radius: 4px;
    font-size: 0.92rem;
  }
  .direct-contact-checklist ul {
    margin: 0.4rem 0 0.6rem;
    padding-inline-start: 1.25rem;
  }
  .direct-contact-checklist li {
    margin-bottom: 0.25rem;
    color: var(--text);
  }
  .direct-contact-response {
    margin: 0;
    color: var(--muted-text);
  }
</style>
