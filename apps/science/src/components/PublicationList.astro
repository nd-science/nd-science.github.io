---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@natali/profile";

interface Props {
  items: CollectionEntry<"publications">[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const sorted = [...items].sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const types = [...new Set(sorted.map((item) => item.data.type))];

const typeLabels: Partial<Record<Locale, Record<string, string>>> = {
  ru: {
    journal_article: "Статьи в журналах",
    conference_paper: "Материалы конференций",
    thesis: "Диссертации и авторефераты",
    book_chapter: "Главы книг",
    working_paper: "Рабочие доклады",
    monograph: "Монографии",
  },
  en: {
    journal_article: "Journal Articles",
    conference_paper: "Conference Papers",
    thesis: "Dissertations & Theses",
    book_chapter: "Book Chapters",
    working_paper: "Working Papers",
    monograph: "Monographs",
  },
  zh: {
    journal_article: "期刊论文",
    conference_paper: "国际会议论文",
    thesis: "博士论文与学术答辩",
    book_chapter: "学术专著章节",
    working_paper: "工作论文与专题报告",
    monograph: "专著",
  },
};

function formatType(type: string): string {
  return typeLabels[locale]?.[type] || typeLabels.en?.[type] || type.replaceAll("_", " ");
}

const copy = (locale as string) === "zh"
  ? {
      filters: "出版物筛选", search: "按标题、出版刊物或研究主题检索", type: "出版物类型：", all: "全部文献类型",
      status: (shown: number, total: number) => `显示 ${total} 篇中的 ${shown} 篇文献`, empty: "未找到符合检索条件的文献。",
      source: "查看原文 ↗", cite: "引用 ⎘", citeTitle: "复制文献引用格式到剪贴板",
    }
  : locale === "ru"
  ? {
      filters: "Фильтры публикаций", search: "Поиск по названию, изданию или теме", type: "Тип публикации:", all: "Все типы публикаций",
      status: (shown: number, total: number) => `Показано ${shown} из ${total} публикаций`, empty: "По вашему запросу публикации не найдены.",
      source: "Источник ↗", cite: "Цитировать ⎘", citeTitle: "Скопировать библиографическое описание в буфер обмена",
    }
  : {
      filters: "Publication filters", search: "Search by title, venue or topic", type: "Publication type:", all: "All publication types",
      status: (shown: number, total: number) => `${shown} of ${total} publications shown`, empty: "No publications match your search.",
      source: "Source ↗", cite: "Cite ⎘", citeTitle: "Copy citation to clipboard",
    };
---
<div class="filter-bar" aria-label={copy.filters}>
  <div class="field publication-search">
    <label for="publication-search" class="sr-only">{copy.search}</label>
    <input id="publication-search" type="search" placeholder={copy.search} data-publication-search />
  </div>
  <div class="field">
    <label for="publication-type">{copy.type}</label>
    <select id="publication-type" data-publication-filter>
      <option value="all">{copy.all}</option>
      {types.map((type) => (
        <option value={type}>{formatType(type)}</option>
      ))}
    </select>
  </div>
</div>
<ul class="publication-list" data-publication-list>
  {sorted.map((item) => (
    <li class="publication-item" data-type={item.data.type} data-search={`${item.data.title} ${item.data.venue} ${item.data.researchAreas.join(" ")} ${item.data.authors.join(" ")}`.toLowerCase()}>
      <span class="publication-title">{item.data.title}</span>
      <span>{item.data.authors.join(", ")}</span>
      <span class="publication-meta">{item.data.year}, {formatType(item.data.type)}, {item.data.venue}, {item.data.language.toUpperCase()}</span>
      <div class="publication-links">
        {item.data.doi && <a href={`https://doi.org/${item.data.doi}`} target="_blank" rel="noopener noreferrer">DOI ↗</a>}
        {item.data.url && <a href={item.data.url} target="_blank" rel="noopener noreferrer">{copy.source}</a>}
        <button
          type="button"
          class="cite-button"
          data-copy-cite={`${item.data.authors.join(", ")} (${item.data.year}). ${item.data.title}. ${item.data.venue}.${item.data.doi ? ` https://doi.org/${item.data.doi}` : ""}`}
          title={copy.citeTitle}
        >
          {copy.cite}
        </button>
      </div>
    </li>
  ))}
</ul>
<p class="publication-status" data-publication-status role="status" aria-live="polite">{copy.status(sorted.length, sorted.length)}</p>
<p class="publication-empty" data-publication-empty hidden>{copy.empty}</p>
<style>
  .sr-only {
    block-size: 1px;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    inline-size: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }
  .publication-search { flex: 1 1 18rem; }
  .publication-search input { inline-size: 100%; }
  .publication-status, .publication-empty { color: var(--muted-text); font-size: var(--text-sm); margin: 1rem 0 0; }
  .publication-empty { color: var(--heading); font-weight: var(--weight-bold); }
  .cite-button {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--accent-strong);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    font-family: inherit;
    transition: color 150ms ease;
  }
  .cite-button:hover {
    color: var(--heading);
  }
</style>
<script>
  const filter = document.querySelector<HTMLSelectElement>("[data-publication-filter]");
  const search = document.querySelector<HTMLInputElement>("[data-publication-search]");
  const status = document.querySelector<HTMLElement>("[data-publication-status]");
  const empty = document.querySelector<HTMLElement>("[data-publication-empty]");
  const records = Array.from(document.querySelectorAll<HTMLElement>("[data-publication-list] [data-type]"));
  const currentLocale = document.documentElement.lang;
  const updateFilters = () => {
    const searchTerm = search?.value.trim().toLocaleLowerCase() ?? "";
    let shown = 0;
    records.forEach((item) => {
      const matchesType = !filter || filter.value === "all" || item.dataset.type === filter.value;
      const matchesSearch = !searchTerm || item.dataset.search?.includes(searchTerm);
      item.hidden = !(matchesType && matchesSearch);
      if (!item.hidden) shown += 1;
    });
    if (status) status.textContent = currentLocale === "zh-Hans" || currentLocale === "zh" ? `显示 ${records.length} 篇中的 ${shown} 篇文献` : currentLocale === "ru" ? `Показано ${shown} из ${records.length} публикаций` : `${shown} of ${records.length} publications shown`;
    if (empty) empty.hidden = shown !== 0;
  };
  filter?.addEventListener("change", updateFilters);
  search?.addEventListener("input", updateFilters);

  document.querySelectorAll<HTMLButtonElement>("[data-copy-cite]").forEach((button) => {
    button.addEventListener("click", async () => {
      const text = button.dataset.copyCite;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = button.innerText;
        button.innerText = original.includes("引用") ? "已复制！" : original.includes("Цитировать") ? "Скопировано!" : "Copied!";
        setTimeout(() => {
          button.innerText = original;
        }, 2000);
      } catch (err) {
        console.error("Failed to copy citation:", err);
      }
    });
  });
</script>
