---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { nataliaProfile, PERSON_CANONICAL_ID, professionalIdentifiers, publicContactEmail, sameAsLinks, verifiedMetrics } from "@natali/profile";
import BaseLayout from "@natali/ui/BaseLayout.astro";
import SectionHeading from "@natali/ui/SectionHeading.astro";
import { absoluteUrl, createWebPageJsonLd } from "@natali/seo";
import { scienceCopy } from "../i18n";
import { scienceSiteConfig } from "../site-config";
import ScienceProfile from "./ScienceProfile.astro";
import PublicationList from "./PublicationList.astro";
import ScienceEnquiryForm from "./ScienceEnquiryForm.astro";
import ForbesEducation from "./ForbesEducation.astro";
import PublicationsHero from "./PublicationsHero.astro";
import PublicationNavigation from "./PublicationNavigation.astro";
import PublicationHighlights from "./PublicationHighlights.astro";
import CitationImpact from "./CitationImpact.astro";

interface Props { entry: CollectionEntry<"pages"> }
const { entry } = Astro.props;
const { locale, route } = entry.data;
const copy = scienceCopy[locale];
const { Content } = await render(entry);
const publications = (await getCollection("publications", ({ data }) => data.publicationScope === "public"));
const isHome = route === "home";
const currentPath = isHome ? `/${locale}/` : `/${locale}/${route}/`;
const paths = {
  ru: isHome ? "/ru/" : `/ru/${route}/`,
  en: isHome ? "/en/" : `/en/${route}/`,
  zh: isHome ? "/zh/" : `/zh/${route}/`,
  de: isHome ? "/de/" : `/de/${route}/`,
  fr: isHome ? "/fr/" : `/fr/${route}/`,
  es: isHome ? "/es/" : `/es/${route}/`,
};
const localizeHref = (href: string) => href.startsWith("/") ? `/${locale}${href}` : href;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || scienceSiteConfig.fallbackUrl;
const jsonLd: Record<string, unknown>[] = [
  createWebPageJsonLd({
    name: entry.data.h1,
    description: entry.data.seoDescription,
    url: absoluteUrl(siteUrl, currentPath),
    locale,
    dateModified: entry.data.updatedAt.toISOString(),
  }),
];
if (route === "publications") {
  publications.forEach((publication) =>
    jsonLd.push({
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline: publication.data.title,
      author: {
        "@type": "Person",
        "@id": PERSON_CANONICAL_ID,
        name: nataliaProfile.displayName[locale] || nataliaProfile.displayName.en,
        alternateName: "Nataliia Ovchinnikova",
      },
      datePublished: String(publication.data.year),
      isPartOf: publication.data.venue,
      identifier: publication.data.doi
        ? `https://doi.org/${publication.data.doi}`
        : publication.data.url,
    }),
  );
}
if (route === "projects") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "ResearchProject",
    name:
      locale === "ru"
        ? "Факторы воспринимаемой эффективности онлайн-подготовки педагогов СПО"
        : (locale as string) === "zh"
        ? "俄罗斯职业院校工程教育师资在线培训感知有效性关键影响因素"
        : (locale as string) === "de"
        ? "Schlüsselfaktoren der wahrgenommenen Wirksamkeit von Online-Kursen für Berufsschullehrkräfte"
        : (locale as string) === "fr"
        ? "Facteurs déterminants de l'efficacité perçue de la formation en ligne pour les enseignants de l'EFTP"
        : (locale as string) === "es"
        ? "Factores determinantes de la eficacia percibida de la formación en línea para docentes de EFTP"
        : "Factors shaping the perceived effectiveness of online preparation for TVET educators",
    member: {
      "@type": "Person",
      "@id": PERSON_CANONICAL_ID,
      name: nataliaProfile.displayName[locale] || nataliaProfile.displayName.en,
    },
  });
}
if (route === "expert-services") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Service",
    name:
      locale === "ru"
        ? "Исследовательские и образовательные услуги"
        : (locale as string) === "zh"
        ? "学术科研与教育培训咨询服务"
        : (locale as string) === "de"
        ? "Forschungs- und Bildungsdienstleistungen"
        : (locale as string) === "fr"
        ? "Services de recherche et d'expertise en éducation"
        : (locale as string) === "es"
        ? "Servicios de investigación y consultoría experta en educación"
        : "Research and education services",
    provider: {
      "@type": "Person",
      "@id": PERSON_CANONICAL_ID,
      name: nataliaProfile.displayName[locale] || nataliaProfile.displayName.en,
    },
    areaServed: {
      "@type": "AdministrativeArea",
      name: locale === "ru" ? "Международное сотрудничество" : locale === "zh" ? "国际学术合作" : locale === "de" ? "Internationale Zusammenarbeit" : locale === "fr" ? "Coopération internationale" : locale === "es" ? "Cooperación internacional" : "International Collaboration",
    },
    availableLanguage: ["ru", "en", "zh", "de", "fr", "es"],
  });
}
if (route === "research/dissertation") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Thesis",
    name: "Key Factors of Online Course Perceived Effectiveness for Preparing TVET Engineering Teachers in Russia",
    author: {
      "@type": "Person",
      "@id": PERSON_CANONICAL_ID,
      name: "Nataliia Dolgova",
      alternateName: "Nataliia Ovchinnikova",
    },
    sourceOrganization: {
      "@type": "CollegeOrUniversity",
      name: "Europa-Universität Flensburg",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Flensburg",
        addressCountry: "DE",
      },
    },
    datePublished: "2025",
    url: "https://www.zhb-flensburg.de/dissert/dolgova",
  });
}
const wellnessOrigin = (
  import.meta.env.PUBLIC_WELLNESS_SITE_URL ||
  (copy.crossSiteHrefBase && !copy.crossSiteHrefBase.includes(".invalid") ? copy.crossSiteHrefBase : "https://natalicompass.com")
).replace(/\/+$/, "");

const crossSiteHref = route === "about"
  ? `${wellnessOrigin}/${locale}/about/`
  : `${wellnessOrigin}/${locale}/`;

const crossSite = {
  category: copy.crossSiteCategory,
  label: copy.crossSiteLabel,
  href: crossSiteHref,
};
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const endpoint = turnstileSiteKey
  ? import.meta.env.PUBLIC_ENQUIRY_WEBHOOK_URL || "https://script.google.com/macros/s/AKfycbzeq7In-ycmZ-Fw7Sl2LTpVcltlaFePSIGrLnZlEVxhNMsMyyaBxNaYtn2ac6u10zmeGQ/exec"
  : undefined;
const cta = entry.data.ctaLabel && entry.data.ctaHref ? { label: entry.data.ctaLabel, href: localizeHref(entry.data.ctaHref) } : undefined;
const secondary = entry.data.ctaSecondaryLabel && entry.data.ctaSecondaryHref ? { label: entry.data.ctaSecondaryLabel, href: localizeHref(entry.data.ctaSecondaryHref) } : undefined;
const pageTitle = isHome
  ? entry.data.seoTitle
  : (entry.data.seoTitle.includes("Долгов") || entry.data.seoTitle.includes("Dolgova")
    ? `${entry.data.seoTitle} | Science`
    : `${entry.data.seoTitle} | ${scienceSiteConfig.name}`);
---
<BaseLayout
  locale={locale} theme="science" siteLabel={copy.siteLabel}
  title={pageTitle} description={entry.data.seoDescription}
  {paths} fallbackSiteUrl={scienceSiteConfig.fallbackUrl} navItems={copy.nav} {currentPath} {crossSite}
  breadcrumbs={isHome ? undefined : [{ label: entry.data.h1 }]}
  personDetails={{ id: PERSON_CANONICAL_ID, email: publicContactEmail, jobTitle: nataliaProfile.scienceRole[locale] || nataliaProfile.scienceRole.en, alternateName: "Nataliia Ovchinnikova", knowsAbout: ["vocational education", "adult learning", "TVET educator training", "digital transformation in education", "technology transfer"], sameAs: sameAsLinks }}
  {jsonLd} footerText={copy.footer}
>
  <section class={isHome ? "hero" : "hero page-hero"}>
    {isHome ? (
      <div class="hero-layout">
        <div class="hero-content">
          <h1>{entry.data.h1}</h1>
          <p class="hero-copy">{entry.data.summary}</p>
          {(cta || secondary) && (
            <div class="actions">
              {cta && <a class="button" href={cta.href}>{cta.label}</a>}
              {secondary && <a class="button secondary" href={secondary.href}>{secondary.label}</a>}
            </div>
          )}
        </div>
        <aside class="hero-media" aria-label={locale === "ru" ? "Академический профиль Наталии Долговой" : locale === "zh" ? "娜塔莉亚·多尔戈娃的学术档案" : locale === "de" ? "Wissenschaftliches Profil von Nataliia Dolgova" : locale === "fr" ? "Profil académique de Nataliia Dolgova" : locale === "es" ? "Perfil académico de Nataliia Dolgova" : "Academic profile of Nataliia Dolgova"}>
          <div class="portrait-card">
            <div class="portrait-frame">
              <img
                src="/images/natalia-portrait.png"
                alt={locale === "ru"
                  ? "Наталия Долгова — Dr. phil. (magna cum laude), исследователь образования"
                  : (locale as string) === "zh"
                  ? "娜塔莉亚·多尔戈娃 — 哲学博士 (magna cum laude)，职业教育学者"
                  : (locale as string) === "de"
                  ? "Nataliia Dolgova — Dr. phil. (magna cum laude), Bildungsforscherin"
                  : (locale as string) === "fr"
                  ? "Nataliia Dolgova — Dr. phil. (magna cum laude), chercheuse en éducation"
                  : (locale as string) === "es"
                  ? "Nataliia Dolgova — Dr. phil. (magna cum laude), investigadora en educación"
                  : "Nataliia Dolgova — Dr. phil. (magna cum laude), TVET Researcher"}
                width="440"
                height="520"
                loading="eager"
                decoding="async"
                class="portrait-img"
              />
            </div>
            <div class="portrait-caption">
              <p class="portrait-name">{nataliaProfile.displayName[locale] || nataliaProfile.displayName.en}</p>
              <p class="portrait-title">
                {locale === "ru"
                  ? "Dr. phil. (magna cum laude), к.э.н., исследователь образования"
                  : (locale as string) === "zh"
                  ? "哲学博士 (magna cum laude)，经济学副博士，职业教育学者"
                  : (locale as string) === "de"
                  ? "Dr. phil. (magna cum laude), Cand. Sc., Bildungsforscherin"
                  : (locale as string) === "fr"
                  ? "Dr. phil. (magna cum laude), docteure en sciences écon., chercheuse en éducation"
                  : (locale as string) === "es"
                  ? "Dr. phil. (magna cum laude), doctora en ciencias económicas, investigadora en educación"
                  : "Dr. phil. (magna cum laude), Cand. Sc., TVET Researcher"}
              </p>
              <span class="portrait-pill">
                Europa-Universität Flensburg
              </span>
              <span class="portrait-location">
                ORCID: 0000-0003-0816-2103 | Scopus: 57202091034
              </span>
            </div>
          </div>
        </aside>
      </div>
    ) : route === "publications" ? (
      <PublicationsHero {locale} title={entry.data.h1} summary={entry.data.summary} />
    ) : (
      <div class="hero-content">
        <h1>{entry.data.h1}</h1>
        <p class="hero-copy">{entry.data.summary}</p>
        {(cta || secondary) && (
          <div class="actions">
            {cta && <a class="button" href={cta.href}>{cta.label}</a>}
            {secondary && <a class="button secondary" href={secondary.href}>{secondary.label}</a>}
          </div>
        )}
      </div>
    )}
  </section>
  {route !== "publications" && <section class="page-section"><div class="section-inner prose"><Content /></div></section>}
  {route === "publications" && (
    <>
      <PublicationNavigation {locale} />
      <section class="page-section"><div class="section-inner"><PublicationHighlights items={publications} {locale} /></div></section>
      <section class="page-section"><div class="section-inner"><CitationImpact {locale} /></div></section>
    </>
  )}
  {entry.data.sections.includes("credentials") && <section class="page-section"><div class="section-inner"><SectionHeading {...copy.sections.credentials} /><ScienceProfile {locale} /></div></section>}
  {entry.data.sections.includes("publications") && <section class="page-section" id="bibliographic-register"><div class="section-inner"><SectionHeading {...copy.sections.publications} /><PublicationList items={publications} {locale} /></div></section>}
  {entry.data.sections.includes("forbes-education") && <section class="page-section" id="forbes-education"><div class="section-inner"><ForbesEducation {locale} /></div></section>}
  {entry.data.sections.includes("profiles") && (
    <section class="page-section" id="scholarly-profiles">
      <div class="section-inner">
        <SectionHeading {...copy.sections.profiles} />
        <ul class="profile-list">
          <li><span class="profile-name">Google Scholar</span><a href={professionalIdentifiers.googleScholarUrl} target="_blank" rel="noopener noreferrer">{locale === "ru" ? "Профиль цитирований" : (locale as string) === "zh" ? "引文档案" : (locale as string) === "de" ? "Zitationsprofil" : (locale as string) === "fr" ? "Profil de citations" : (locale as string) === "es" ? "Perfil de citas" : "Citation profile"} ↗</a></li>
          <li><span class="profile-name">РИНЦ / eLibrary</span><a href={professionalIdentifiers.elibraryUrl} target="_blank" rel="noopener noreferrer">{professionalIdentifiers.elibraryAuthorId} ↗</a></li>
          <li><span class="profile-name">ORCID</span><a href={professionalIdentifiers.orcidUrl} target="_blank" rel="noopener noreferrer">{professionalIdentifiers.orcid} ↗</a></li>
          <li><span class="profile-name">Scopus Author ID</span><a href={professionalIdentifiers.scopusUrl} target="_blank" rel="noopener noreferrer">{professionalIdentifiers.scopusAuthorId} ↗</a></li>
          <li><span class="profile-name">ResearcherID</span><a href={professionalIdentifiers.researcherIdUrl} target="_blank" rel="noopener noreferrer">{professionalIdentifiers.researcherId} ↗</a></li>
          <li><span class="profile-name">LinkedIn</span><a href="https://www.linkedin.com/in/natalidolgova" target="_blank" rel="noopener noreferrer">natalidolgova ↗</a></li>
        </ul>
        <div class="metrics-block">
          <p class="metrics-table-caption"><strong>{locale === "ru" ? "Сводные наукометрические показатели" : (locale as string) === "zh" ? "综合科研文献计量指标" : (locale as string) === "de" ? "Wissenschaftsmetrische Kennzahlen" : (locale as string) === "fr" ? "Indicateurs bibliométriques de synthèse" : (locale as string) === "es" ? "Indicadores bibliométricos de síntesis" : "Summary bibliometric indicators"}</strong> &mdash; <span>{locale === "ru" ? "верифицировано по официальным профилям автора" : (locale as string) === "zh" ? "经作者官方数据库档案核实" : (locale as string) === "de" ? "über offizielle Autorenprofile verifiziert" : (locale as string) === "fr" ? "vérifié via les profils d'auteure officiels" : (locale as string) === "es" ? "verificado mediante perfiles de autora oficiales" : "verified via author profiles"}</span></p>
          <div class="table-container" tabindex="0" role="region" aria-label={locale === "ru" ? "Таблица наукометрических показателей" : (locale as string) === "zh" ? "科研计量指标汇总表" : (locale as string) === "de" ? "Tabelle wissenschaftsmetrischer Kennzahlen" : (locale as string) === "fr" ? "Tableau des indicateurs bibliométriques" : (locale as string) === "es" ? "Tabla de indicadores bibliométricos" : "Bibliometric indicators table"}>
            <table class="metrics-table">
              <thead>
                <tr>
                  <th scope="col">{locale === "ru" ? "База данных" : (locale as string) === "zh" ? "数据库" : (locale as string) === "de" ? "Datenbank" : (locale as string) === "fr" ? "Base de données" : (locale as string) === "es" ? "Base de datos" : "Database"}</th>
                  <th scope="col" style="text-align: center;">h-index</th>
                  <th scope="col" style="text-align: center;">{locale === "ru" ? "Публикаций" : (locale as string) === "zh" ? "出版物" : (locale as string) === "de" ? "Publikationen" : (locale as string) === "fr" ? "Publications" : (locale as string) === "es" ? "Publicaciones" : "Publications"}</th>
                  <th scope="col" style="text-align: center;">{locale === "ru" ? "Цитирований" : (locale as string) === "zh" ? "引用次数" : (locale as string) === "de" ? "Zitationen" : (locale as string) === "fr" ? "Citations" : (locale as string) === "es" ? "Citas" : "Citations"}</th>
                  <th scope="col">{locale === "ru" ? "Дата проверки" : (locale as string) === "zh" ? "核查日期" : (locale as string) === "de" ? "Stand" : (locale as string) === "fr" ? "Date de vérification" : (locale as string) === "es" ? "Fecha de verificación" : "As of"}</th>
                  <th scope="col">{locale === "ru" ? "Охват и профиль" : (locale as string) === "zh" ? "收录范围与档案" : (locale as string) === "de" ? "Abdeckung & Quelle" : (locale as string) === "fr" ? "Périmètre & Source" : (locale as string) === "es" ? "Cobertura y fuente" : "Coverage & Source"}</th>
                </tr>
              </thead>
              <tbody>
                {verifiedMetrics.map((m) => (
                  <tr>
                    <td data-label={locale === "ru" ? "База данных" : (locale as string) === "zh" ? "数据库" : (locale as string) === "de" ? "Datenbank" : (locale as string) === "fr" ? "Base de données" : (locale as string) === "es" ? "Base de datos" : "Database"}><strong>{m.database}</strong></td>
                    <td data-label="h-index" style="text-align: center;"><span class="metric-badge">{m.hIndex}</span></td>
                    <td data-label={locale === "ru" ? "Публикаций" : (locale as string) === "zh" ? "出版物" : (locale as string) === "de" ? "Publikationen" : (locale as string) === "fr" ? "Publications" : (locale as string) === "es" ? "Publicaciones" : "Publications"} style="text-align: center;">{m.documents}</td>
                    <td data-label={locale === "ru" ? "Цитирований" : (locale as string) === "zh" ? "引用次数" : (locale as string) === "de" ? "Zitationen" : (locale as string) === "fr" ? "Citations" : (locale as string) === "es" ? "Citas" : "Citations"} style="text-align: center;">{m.citations}</td>
                    <td data-label={locale === "ru" ? "Дата проверки" : (locale as string) === "zh" ? "核查日期" : (locale as string) === "de" ? "Stand" : (locale as string) === "fr" ? "Date de vérification" : (locale as string) === "es" ? "Fecha de verificación" : "As of"} class="metric-date">{m.checkedAt}</td>
                    <td data-label={locale === "ru" ? "Охват и профиль" : (locale as string) === "zh" ? "收录范围与档案" : (locale as string) === "de" ? "Abdeckung & Quelle" : (locale as string) === "fr" ? "Périmètre & Source" : (locale as string) === "es" ? "Cobertura y fuente" : "Coverage & Source"}>
                      <p class="metric-note">{m.notes[locale] || m.notes.en || m.notes.ru}</p>
                      <a class="metric-link" href={m.databaseUrl} target="_blank" rel="noopener noreferrer">
                        {locale === "ru" ? "Профиль в базе" : (locale as string) === "zh" ? "查看原始档案" : (locale as string) === "de" ? "Profil in der Datenbank" : (locale as string) === "fr" ? "Profil dans la base" : (locale as string) === "es" ? "Perfil en la base" : "View source profile"} ↗
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  )}
  {entry.data.sections.includes("contact-form") && <section class="page-section" id="enquiry"><div class="section-inner"><SectionHeading {...copy.sections.form} /><ScienceEnquiryForm {locale} {endpoint} {turnstileSiteKey} /></div></section>}
</BaseLayout>
