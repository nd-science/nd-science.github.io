---
// Static root language detection and immediate redirect
---
<!doctype html>
<html lang="en" data-theme="science">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nataliia Dolgova | Science</title>
    <meta name="robots" content="noindex" />
    <meta name="google-site-verification" content="od8PTNpX3EwB1eK7vjlpEAYKrfkwkxFKHj0X-Y4csXc" />
    <meta name="yandex-verification" content="80f02dc8bb2d1a79" />
    <script is:inline>
      (function() {
        try {
          var langs = navigator.languages || [navigator.language || navigator.userLanguage || ''];
          var target = 'en';
          for (var i = 0; i < langs.length; i++) {
            var lang = (langs[i] || '').toLowerCase();
            if (lang.indexOf('ru') === 0) {
              target = 'ru';
              break;
            }
            if (lang.indexOf('zh') === 0) {
              target = 'zh';
              break;
            }
            if (lang.indexOf('de') === 0) {
              target = 'de';
              break;
            }
            if (lang.indexOf('fr') === 0) {
              target = 'fr';
              break;
            }
            if (lang.indexOf('es') === 0) {
              target = 'es';
              break;
            }
            if (lang.indexOf('en') === 0) {
              target = 'en';
              break;
            }
          }
          location.replace('/' + target + '/');
        } catch (e) {
          location.replace('/en/');
        }
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: oklch(0.985 0.008 250);
        color: oklch(0.32 0.04 250);
      }
      .redirect-box {
        text-align: center;
        padding: 2rem;
      }
      .redirect-links {
        margin-top: 1rem;
        display: flex;
        gap: 1.5rem;
        justify-content: center;
      }
      .redirect-links a {
        color: oklch(0.42 0.13 250);
        font-weight: 600;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <main class="redirect-box">
      <p>Redirecting / Перенаправление…</p>
      <div class="redirect-links">
        <a href="/en/">English version (EN)</a>
        <a href="/ru/">Русская версия (RU)</a>
        <a href="/zh/">中文版本 (ZH)</a>
        <a href="/de/">Deutsche Version (DE)</a>
        <a href="/fr/">Version française (FR)</a>
        <a href="/es/">Versión en español (ES)</a>
      </div>
    </main>
  </body>
</html>
