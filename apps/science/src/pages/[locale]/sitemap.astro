          ? "全站所有主要栏目、研究方向、博士论文、学术出版物及学者档案的统一索引。"
          : isRu
          ? "Все разделы, научные направления, диссертация, публикации и профили исследователя в едином оглавлении."
          : "Complete directory of all sections, research areas, dissertation, publications, and scholar profiles."}
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="section-inner">
      <div class="sitemap-grid">
        {categories.map((category) => (
          <div class="sitemap-category">
            <h2>{category.title}</h2>
            <ul class="sitemap-list">
              {category.items.map((item) => (
                <li>
                  <a class="sitemap-item-link" href={item.href}>
                    {item.label}
                  </a>
                  <p class="sitemap-item-desc">{item.desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
