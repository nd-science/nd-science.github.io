---
import BaseLayout from "@natali/ui/BaseLayout.astro";
import { scienceSiteConfig } from "../../site-config";
import { scienceCopy } from "../../i18n";

export function getStaticPaths() {
  return [
    { params: { locale: "ru" } },
    { params: { locale: "en" } },
    { params: { locale: "zh" } },
    { params: { locale: "de" } },
    { params: { locale: "fr" } },
    { params: { locale: "es" } },
  ];
}

const { locale } = Astro.params as { locale: "ru" | "en" | "zh" | "de" | "fr" | "es" };
const copy = scienceCopy[locale] as any || scienceCopy.en;
const paths = { ru: "/ru/privacy/", en: "/en/privacy/", zh: "/zh/privacy/", de: "/de/privacy/", fr: "/fr/privacy/", es: "/es/privacy/" };
const currentPath = `/${locale}/privacy/`;
const isRu = locale === "ru";
const isZh = locale === "zh";
const isDe = locale === "de";
const isFr = locale === "fr";
const isEs = locale === "es";

const breadcrumbs = [
  { label: isEs ? "Política de privacidad" : isFr ? "Politique de confidentialité" : isDe ? "Datenschutzerklärung" : isZh ? "个人信息保护政策" : isRu ? "Политика конфиденциальности" : "Privacy Policy" },
];
---

<BaseLayout
  locale={locale}
  theme="science"
  siteLabel={copy.siteLabel}
  title={`${isEs ? "Política de privacidad" : isFr ? "Politique de confidentialité" : isDe ? "Datenschutzerklärung" : isZh ? "个人信息与数据保护政策" : isRu ? "Политика обработки персональных данных" : "Privacy Policy"} | ${scienceSiteConfig.name}`}
  description={isEs ? "Principios de tratamiento y protección de datos personales en el envío de consultas de colaboración a través del sitio académico de Nataliia Dolgova." : isFr ? "Principes de traitement et de protection des données personnelles lors de l'envoi de demandes de collaboration sur le site académique de Nataliia Dolgova." : isDe ? "Grundsätze der Verarbeitung und des Schutzes personenbezogener Daten bei Projektanfragen über die akademische Website von Nataliia Dolgova." : isZh ? "通过娜塔莉亚·多尔戈娃学术网站提交合作意向与咨询时的个人数据处理与隐私保护政策。" : isRu ? "Политика обработки и защиты персональных данных при направлении экспертных запросов через академический сайт Наталии Долговой." : "Personal data processing and privacy policy for expert and research inquiries to Natalia Dolgova."}
  paths={paths}
  fallbackSiteUrl={scienceSiteConfig.fallbackUrl}
  navItems={copy.nav}
  currentPath={currentPath}
  breadcrumbs={breadcrumbs}
  footerText={copy.footer}
